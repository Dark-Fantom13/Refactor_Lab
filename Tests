        [Test]
        public void TestRegularItemLessThan3()
        {
            Customer customer = new Customer("John", 10);
            BillGenerator bill = new BillGenerator(new TxtView(), new Bill(customer));
            RegularGoods goods = new RegularGoods("Book");// раньше было Goods goods = new Goods("Book", тип товара)
            Item item = new Item(goods, 2, 100);
            bill.addGoods(item);

            string result = bill.statement();
            Assert.IsTrue(result.Contains("Сумма счета составляет 200"));
            Assert.IsTrue(result.Contains("Вы заработали 10 бонусных балов"));
        }

