        [Test]
        public void TestMixedItems()
        {
            Customer customer = new Customer("John", 0);
            BillGenerator bill = new BillGenerator(new TxtView(), new Bill(customer));
            RegularGoods goods1 = new RegularGoods("Book");
            SpecialOrderGoods goods2 = new SpecialOrderGoods("TV");
            SaleGoods goods3 = new SaleGoods("Phone");
            Item item1 = new Item(goods1, 3, 100);
            Item item2 = new Item(goods2, 15, 200);
            Item item3 = new Item(goods3, 5, 300);
            bill.addGoods(item1);
            bill.addGoods(item2);
            bill.addGoods(item3);

            string result = bill.statement();
            Assert.IsTrue(result.Contains("Сумма счета составляет 4761")); //4776 было, 4761 стало
            Assert.IsTrue(result.Contains("Вы заработали 30 бонусных балов"));
        }

